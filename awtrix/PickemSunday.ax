# @name    Pickem Sunday
# @desc    Sunday-only Teal's Pick'em broadcast via scoped Supabase RPC
# @author  Teal's Sunday Pick'em
# @version 1.0.7-hotfix7.18
# @headless true
# @config  sb_url text "Supabase URL" default="" maxlen=160
# @config  sb_key text "Publishable key" default="" maxlen=256
# @config  token text "Clock token" default="" maxlen=128
# @config  poll number "Sunday poll" default=10 min=10 max=60 unit=sec
# Prior config marker: @config  poll number "Sunday poll" default=15 min=10 max=60 unit=sec

import json

class PickemSunday
  var ticks, in_flight, last_event

  def init()
    self.ticks = 1
    self.in_flight = false
    self.last_event = store.get("last_event", "")
  end

  def headers()
    return {
      "apikey": store.get("sb_key"),
      "Content-Type": "application/json",
      "Accept": "application/json"
    }
  end

  def ack(event_id)
    var url = store.get("sb_url") + "/rest/v1/rpc/pickem_clock_ack"
    var body = json.dump({"p_token": store.get("token"), "p_event_id": event_id})
    http.post(url, body, def (b, st) end, {"headers": self.headers()})
  end

  def normalize_fragments(fragments)
    if fragments == nil || !isinstance(fragments, list) return nil end
    var out = []
    var i = 0
    while i < size(fragments)
      var part = fragments[i]
      if isinstance(part, map)
        var text = part.find("text")
        if text == nil
          text = part.find("t")
        end
        var color = part.find("color")
        if color == nil
          color = part.find("c")
        end
        if text != nil && str(text) != ""
          if color != nil && str(color) != ""
            out.push({"text": str(text), "color": str(color)})
          else
            out.push({"text": str(text)})
          end
        end
      end
      i += 1
    end
    if size(out) == 0 return nil end
    return out
  end

  def on_feed(body, status)
    self.in_flight = false
    if status < 200 || status >= 300 || body == nil return end

    var data = json.load(body)
    if !isinstance(data, map) return end
    if data.find("ok") != true || data.find("active") != true return end

    var event_id = data.find("event_id")
    var line = data.find("text")
    var fragments = data.find("fragments")
    if event_id == nil || line == nil || line == "" return end
    if event_id == self.last_event return end

    var color = data.find("color")
    var category = data.find("category")
    var repeat_count = 1
    # Long score/standings/preview tickers get two complete passes every time
    # they activate. Other categories keep their established single pass.
    if category == "preview" || category == "live_games" || category == "weekly"
      repeat_count = 2
    end
    var stack_it = true
    # Fast-changing automatic sports/status messages replace the currently
    # displayed notification instead of waiting behind an older sports item.
    # Commissioner/manual messages remain stacked so they can finish normally.
    if category == "live_games" || category == "weekly" || category == "player" || category == "season" || category == "pulse" || category == "readiness" || category == "preview" || category == "fallback"
      stack_it = false
    end
    var accepted = false
    var rich = self.normalize_fragments(fragments)
    # This optional field is supplied ONLY for a selected Commissioner message.
    # Legacy feeds omit it; invalid RTTTL always falls back to silent text.
    var melody = nil
    # Legacy melody-condition marker: data.find("category") == "manual" && data.find("test") != true
    if category == "manual" && data.find("test") != true
      melody = data.find("rtttl")
    end
    if rich != nil
      if melody != nil && str(melody) != ""
        accepted = notify({"text": rich, "repeat": repeat_count, "stack": stack_it, "wakeup": true, "soundRtttl": str(melody)})
      end
      if !accepted
        # Legacy silent-fallback marker: accepted = notify({"text": rich, "repeat": 1, "stack": true, "wakeup": true})
        accepted = notify({"text": rich, "repeat": repeat_count, "stack": stack_it, "wakeup": true})
      end
    end
    if !accepted
      if color != nil && color != ""
        if melody != nil && str(melody) != ""
          accepted = notify({"text": str(line), "textColor": str(color), "repeat": repeat_count, "stack": stack_it, "wakeup": true, "soundRtttl": str(melody)})
        end
        if !accepted
          accepted = notify({"text": str(line), "textColor": str(color), "repeat": repeat_count, "stack": stack_it, "wakeup": true})
        end
      else
        if melody != nil && str(melody) != ""
          accepted = notify({"text": str(line), "repeat": repeat_count, "stack": stack_it, "wakeup": true, "soundRtttl": str(melody)})
        end
        if !accepted
          accepted = notify({"text": str(line), "repeat": repeat_count, "stack": stack_it, "wakeup": true})
        end
      end
    end
    if accepted
      self.last_event = event_id
      store.set("last_event", event_id)
      self.ack(str(event_id))
    end
  end

  def fetch()
    if self.in_flight return end

    var sb_url = store.get("sb_url")
    var sb_key = store.get("sb_key")
    var token = store.get("token")
    if sb_url == nil || sb_url == "" || sb_key == nil || sb_key == "" || token == nil || token == ""
      return
    end

    self.in_flight = true
    var url = sb_url + "/rest/v1/rpc/pickem_clock_feed"
    var body = json.dump({"p_token": token})
    http.post(url, body, / b, st -> self.on_feed(b, st), {"headers": self.headers()})
  end

  def loop()
    if self.ticks <= 0
      self.fetch()

      var dow = weekday()
      if dow == 0
        # Prior poll assignment marker: self.ticks = 15
        # Sunday sports content checks every 10 seconds. The feed still emits
        # only one event per scheduled slot, so faster polling does not create
        # duplicate ticker messages.
        self.ticks = 10
      elif dow == 6
        # Saturday preview events occur every 15 minutes; checking twice per
        # minute keeps each preview close to its quarter-hour boundary.
        self.ticks = 30
      elif dow >= 4
        self.ticks = 60
      else
        self.ticks = 900
      end
    end

    self.ticks -= 1
  end
end

return PickemSunday()
