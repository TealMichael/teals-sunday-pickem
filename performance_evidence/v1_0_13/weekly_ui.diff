+def _take_lineup_action(player: dict) -> dict | None:
+    # Pop before any early return or data read. Requests cannot survive a tab
+    # change, failed render, missing week, lock transition or failed save.
+    request = st.session_state.pop("lineup_action", None)
+    generation = st.session_state.get("lineup_render_generation", 0)
+    st.session_state.lineup_render_generation = generation + 1
+    if not isinstance(request, dict):
+        return None
+    expected = {
+        "player_id": str(player["id"]), "generation": generation,
+        "session": _action_session_context(),
+        "mode": str(st.session_state.get("builder_mode") or "home"),
+        "position": st.session_state.get("builder_position"),
+        "return_mode": st.session_state.get("builder_return_mode"),
+    }
+    return request if all(request.get(k) == value for k, value in expected.items()) else None
